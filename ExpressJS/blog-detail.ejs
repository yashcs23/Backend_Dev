<!DOCTYPE html>
<html>
<head>
  <title><%= post.title %></title>
  <style>
    body { font-family: Arial; max-width: 800px; margin: 50px auto; }
    .post-header { border-bottom: 2px solid #007bff; padding-bottom: 10px; }
    .post-meta { color: #666; font-size: 14px; }
    .post-content { margin: 20px 0; line-height: 1.6; }
    a { color: #007bff; text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <a href="/blog">Back to Blog</a>
  <div class="post-header">
    <h1><%= post.title %></h1>
    <div class="post-meta">By <%= post.author %> on <%= post.date.toLocaleDateString() %></div>
  </div>
  <div class="post-content">
    <p><%= post.content %></p>
  </div>
</body>
</html>
