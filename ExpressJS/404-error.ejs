<!DOCTYPE html>
<html>
<head>
  <title>404 Error</title>
  <style>
    body { font-family: Arial; max-width: 600px; margin: 100px auto; text-align: center; }
    .error-container { background-color: #f8d7da; border: 1px solid #f5c6cb; padding: 20px; border-radius: 5px; }
    h1 { color: #721c24; font-size: 48px; margin: 0; }
    p { color: #721c24; font-size: 18px; }
    a { color: #007bff; text-decoration: none; display: inline-block; margin-top: 20px; }
  </style>
</head>
<body>
  <div class="error-container">
    <h1>404</h1>
    <p>Page Not Found</p>
    <p>The page you requested "<%= requested %>" does not exist.</p>
    <a href="/">Back to Home</a>
  </div>
</body>
</html>
