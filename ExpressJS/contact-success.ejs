<!DOCTYPE html>
<html>
<head>
  <title>Message Sent</title>
  <style>
    body { font-family: Arial; max-width: 600px; margin: 50px auto; text-align: center; }
    .success { color: green; }
    a { color: #007bff; text-decoration: none; margin-top: 20px; display: inline-block; }
  </style>
</head>
<body>
  <h1 class="success">Thank You!</h1>
  <p>Your message has been sent successfully, <%= name %>!</p>
  <p>We will get back to you soon.</p>
  <a href="/contact">Send another message</a>
  <br>
  <a href="/contacts">View all contacts</a>
</body>
</html>
